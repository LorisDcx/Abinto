RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=contact@votre-domaine.fr
CONTACT_FROM_EMAIL=ABINTO <contact@votre-domaine.fr>
BOOKING_FROM_EMAIL=ABINTO <contact@votre-domaine.fr>

# Agenda de réservation Google Calendar
# Partagez le calendrier concerné avec l'adresse du compte de service, avec le droit
# « Modifier les événements ». La clé privée doit conserver ses retours à la ligne
# sous la forme \n dans la variable Vercel.
GOOGLE_CALENDAR_ID=votre-calendrier@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=abinto-booking@votre-projet.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Règles de disponibilité (heure de Paris). Les jours vont de 0 (dimanche) à 6 (samedi).
BOOKING_TIMEZONE=Europe/Paris
BOOKING_DURATION_MINUTES=30
BOOKING_SLOT_MINUTES=30
BOOKING_MIN_NOTICE_HOURS=24
BOOKING_WINDOW_DAYS=45
BOOKING_AVAILABILITY={"1":["09:00-12:00","14:00-18:00"],"2":["09:00-12:00","14:00-18:00"],"3":["09:00-12:00","14:00-18:00"],"4":["09:00-12:00","14:00-18:00"],"5":["09:00-12:00","14:00-17:00"]}
